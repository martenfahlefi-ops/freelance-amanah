<!DOCTYPE html>
<html lang="id">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= typeof title !== 'undefined' ? title : 'Admin - FREELANCE AMANAH' %></title><link rel="stylesheet" href="/css/style.css"></head>
<body><div class="bg-animated"><div class="bg-gradient bg-gradient-1"></div><div class="bg-gradient bg-gradient-2"></div><div class="bg-gradient bg-gradient-3"></div></div>
<button class="mobile-toggle" onclick="toggleSidebar()">☰</button>
<nav class="sidebar" id="sidebar"><div class="sidebar-logo"><h3>FREELANCE AMANAH</h3><span>Admin Panel</span></div><div class="sidebar-nav"><a href="/admin/dashboard" data-page="dashboard"><span class="icon">🏠</span> Beranda</a><a href="/admin/settings" data-page="settings"><span class="icon">🔧</span> Pengaturan</a><a href="/admin/emails" data-page="emails"><span class="icon">📩</span> Data Email</a><a href="/admin/konfirmasi" data-page="konfirmasi"><span class="icon">📋</span> Konfirmasi Setoran</a></div><div class="sidebar-footer"><a href="/admin/logout" class="btn-outline-light w-100" style="text-decoration:none;text-align:center;display:block;">🚪 Keluar</a></div></nav>
<div class="main-content" id="mainContent"><%- body %></div>
<a href="https://discord.gg/VhmgYdgxV" target="_blank" class="floating-discord"><svg viewBox="0 0 24 24"><path d="M20.317 4.37a19.8 19.8 0 00-4.885-1.515c-.21.375-.444.864-.608 1.25a18.3 18.3 0 00-5.487 0c-.617-1.25-4.885-1.515-4.885-1.515C.533 9.046-.32 13.58.099 18.057l.031.057a19.9 19.9 0 005.993 3.03c.462-.63.874-1.295 1.226-1.994a13.1 13.1 0 01-1.872-.892l-.008-.128c.372-.292 4-1.793 12.062 0l.373.292-.006.127-1.873.892-.041.107 1.225 1.993.084.028a19.84 19.84 0 006.002-3.03l.032-.054c.5-5.177-.838-9.674-3.549-13.66zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419s.956-2.419 2.157-2.419 2.157 1.086 2.157 2.419-.956 2.419-2.157 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419s.955-2.419 2.157-2.419 2.157 1.086 2.157 2.419-.946 2.419-2.157 2.419z"/></svg></a>
<script>
function toggleSidebar(){document.getElementById('sidebar').classList.toggle('open')}
(function(){var p=window.location.pathname;document.querySelectorAll('.sidebar-nav a').forEach(function(l){var pg=l.getAttribute('data-page');if(pg&&p.includes(pg))l.classList.add('active')})})();
function updateClock(){var n=new Date();var d=n.toLocaleDateString('id-ID',{weekday:'long',year:'numeric',month:'long',day:'numeric'});var h=String(n.getHours()).padStart(2,'0');var m=String(n.getMinutes()).padStart(2,'0');var s=String(n.getSeconds()).padStart(2,'0');var de=document.getElementById('clockDate');var te=document.getElementById('clockTime');if(de)de.textContent=d;if(te)te.innerHTML=h+':'+m+':<span class="seconds">'+s+'</span>'}
setInterval(updateClock,1000);updateClock();
document.addEventListener('click',function(e){var sb=document.getElementById('sidebar');var tg=document.querySelector('.mobile-toggle');if(window.innerWidth<=768){if(!sb.contains(e.target)&&!tg.contains(e.target))sb.classList.remove('open')}});
</script></body></html>