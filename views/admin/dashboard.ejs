<div class="top-bar"><div class="page-title">🏠 Beranda Admin</div><div class="clock-display"><div><div class="date" id="clockDate"></div><div class="time" id="clockTime">00:00:<span class="seconds">00</span></div></div></div></div>
<div id="dashboardAlert"></div>
<div class="stats-grid" id="statsGrid">
<div class="stat-card total"><div class="stat-icon">📊</div><div class="stat-value" id="statTotal"><%= stats.totalSetoran %></div><div class="stat-label">Total Setoran</div></div>
<div class="stat-card pending pulse"><div class="stat-icon">⏳</div><div class="stat-value" id="statPending"><%= stats.pending %></div><div class="stat-label">Pending</div></div>
<div class="stat-card accepted"><div class="stat-icon">✅</div><div class="stat-value" id="statAccepted"><%= stats.accepted %></div><div class="stat-label">Accepted</div></div>
<div class="stat-card denied"><div class="stat-icon">❌</div><div class="stat-value" id="statDenied"><%= stats.denied %></div><div class="stat-label">Denied</div></div>
<div class="stat-card bayaran"><div class="stat-icon">💰</div><div class="stat-value" id="statBayaran">Rp <%= stats.totalBayaran.toLocaleString('id-ID') %></div><div class="stat-label">Total Bayaran</div></div></div>
<div style="margin-bottom:24px;"><button class="btn-danger" onclick="resetSetoran()">🔄 Reset Manual (Total Setoran)</button><span style="color:#666;font-size:12px;margin-left:12px;">Card lain (Pending, Accepted, Denied, Bayaran) reset otomatis setiap jam 00:00</span></div>
<div class="glass-card" style="padding:24px;"><h4 style="color:var(--green-primary);margin-bottom:16px;">📜 History Reset</h4><div class="table-container"><table class="table"><thead><tr><th>#</th><th>Tanggal</th><th>Jam</th><th>Data Sebelum Reset</th></tr></thead><tbody id="historyBody"><% if (history && history.length > 0) { %><% history.forEach(function(h, i) { %><tr><td><%= i + 1 %></td><td><%= h.tanggal %></td><td><%= h.jam %></td><td><%= h.data_sebelum %></td></tr><% }); %><% } else { %><tr><td colspan="4" class="msg-empty">Belum ada history reset.</td></tr><% } %></tbody></table></div></div>
<script>
async function refreshStats(){try{var r=await fetch('/admin/api/stats');var d=await r.json();document.getElementById('statTotal').textContent=d.totalSetoran;document.getElementById('statPending').textContent=d.pending;document.getElementById('statAccepted').textContent=d.accepted;document.getElementById('statDenied').textContent=d.denied;document.getElementById('statBayaran').textContent='Rp '+d.totalBayaran.toLocaleString('id-ID')}catch(e){}}
setInterval(refreshStats,10000);
async function resetSetoran(){if(!confirm('Yakin ingin mereset Total Setoran?\n\nData Pending, Accepted, dan Denied akan dihapus.\nHistory akan disimpan.'))return;var a=document.getElementById('dashboardAlert');try{var r=await fetch('/admin/api/reset-setoran',{method:'POST'});var d=await r.json();if(d.success){a.innerHTML='<div class="alert alert-success">✅ Reset berhasil! History telah disimpan.</div>';refreshStats();setTimeout(function(){window.location.reload()},1000)}else{a.innerHTML='<div class="alert alert-danger">❌ Gagal reset!</div>'}}catch(e){a.innerHTML='<div class="alert alert-danger">❌ Server error!</div>'}}
</script>