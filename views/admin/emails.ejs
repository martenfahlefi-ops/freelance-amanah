<div class="top-bar"><div class="page-title">📩 Data Email</div><div class="clock-display"><div><div class="date" id="clockDate"></div><div class="time" id="clockTime">00:00:<span class="seconds">00</span></div></div></div></div>
<div id="emailAlert"></div>
<div class="glass-card" style="padding:24px;margin-bottom:24px;"><h4 style="color:var(--green-primary);margin-bottom:16px;">➕ Tambah Email</h4><div style="display:flex;gap:12px;align-items:flex-end;"><div class="form-group" style="flex:1;margin-bottom:0;"><label class="form-label">Alamat Email</label><input type="email" id="newEmail" class="form-control" placeholder="user@example.com"></div><button class="btn-amanah btn-amanah-solid" onclick="addEmail()" style="height:48px;">➕ Tambah</button></div></div>
<div class="glass-card" style="padding:24px;"><h4 style="color:var(--green-primary);margin-bottom:16px;">📋 Daftar Email</h4><div class="table-container"><table class="table"><thead><tr><th>#</th><th>Email</th><th>Status</th><th>Aksi</th></tr></thead><tbody id="emailBody"><% if (emails && emails.length > 0) { %><% emails.forEach(function(e, i) { %><tr id="emailRow<%= e.id %>"><td><%= i + 1 %></td><td><%= e.email %></td><td><span class="badge <%= e.is_active ? 'badge-accepted' : 'badge-denied' %>"><%= e.is_active ? 'Active' : 'Inactive' %></span></td><td><button class="btn-sm btn-outline-light" onclick="toggleEmail(<%= e.id %>)"><%= e.is_active ? 'Nonaktifkan' : 'Aktifkan' %></button><button class="btn-sm btn-danger" onclick="deleteEmail(<%= e.id %>)" style="margin-left:8px;">🗑 Hapus</button></td></tr><% }); %><% } else { %><tr><td colspan="4" class="msg-empty">Belum ada email terdaftar.</td></tr><% } %></tbody></table></div></div>
<script>
async function addEmail(){var e=document.getElementById('newEmail').value.trim();var a=document.getElementById('emailAlert');if(!e||!e.includes('@')){a.innerHTML='<div class="alert alert-warning">⚠️ Masukkan email yang valid!</div>';return}try{var r=await fetch('/admin/api/emails',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:e})});var d=await r.json();if(d.success){a.innerHTML='<div class="alert alert-success">✅ '+d.message+'</div>';document.getElementById('newEmail').value='';setTimeout(function(){window.location.reload()},500)}else{a.innerHTML='<div class="alert alert-danger">❌ '+d.message+'</div>'}}catch(err){a.innerHTML='<div class="alert alert-danger">❌ Server error!</div>'}}
async function toggleEmail(id){try{var r=await fetch('/admin/api/emails/'+id+'/toggle',{method:'PUT'});var d=await r.json();if(d.success)window.location.reload()}catch(e){}}
async function deleteEmail(id){if(!confirm('Yakin hapus email ini?'))return;try{var r=await fetch('/admin/api/emails/'+id,{method:'DELETE'});var d=await r.json();if(d.success)window.location.reload()}catch(e){}}
</script>