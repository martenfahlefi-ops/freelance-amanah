<div class="top-bar"><div class="page-title">🔧 Pengaturan</div><div class="clock-display"><div><div class="date" id="clockDate"></div><div class="time" id="clockTime">00:00:<span class="seconds">00</span></div></div></div></div>
<div id="settingsAlert"></div>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">
<div class="settings-section"><h4>🔑 Ganti Password Admin</h4><div class="form-group"><label class="form-label">Password Lama</label><input type="password" id="oldPassword" class="form-control" placeholder="Masukkan password lama"></div><div class="form-group"><label class="form-label">Password Baru</label><input type="password" id="newPassword" class="form-control" placeholder="Masukkan password baru"></div><div class="form-group"><label class="form-label">Konfirmasi Password</label><input type="password" id="confirmPassword" class="form-control" placeholder="Ulangi password baru"></div><button class="btn-amanah btn-amanah-solid w-100" onclick="changePassword()">💾 Simpan Password</button></div>
<div><div class="settings-section"><h4>⏰ Jam Operasional</h4><div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;"><div class="form-group"><label class="form-label">Jam OPEN</label><input type="time" id="openTime" class="form-control" value="<%= settings.open_time || '08:00' %>"></div><div class="form-group"><label class="form-label">Jam CLOSE</label><input type="time" id="closeTime" class="form-control" value="<%= settings.close_time || '17:00' %>"></div></div></div><div class="settings-section"><h4>💵 Harga Bayaran</h4><div class="form-group"><label class="form-label">Harga per Setoran (Rp)</label><input type="number" id="hargaBayaran" class="form-control" value="<%= settings.harga_bayaran || '5000' %>" min="0"></div><button class="btn-amanah w-100" onclick="updateTimeAndPrice()">💾 Simpan Jam & Harga</button></div></div></div>
<div class="settings-section" style="margin-top:24px;"><h4>📝 Catatan Bayaran</h4><p style="color:#666;font-size:13px;margin-bottom:12px;">Catatan ini akan muncul otomatis di halaman member.</p><div class="form-group"><textarea id="catatanBayaran" class="form-control" style="min-height:200px;"><%= settings.catatan_bayaran || '' %></textarea></div><button class="btn-amanah btn-amanah-solid w-100" onclick="updateCatatan()">💾 Simpan Catatan</button></div>
<script>
async function changePassword(){var o=document.getElementById('oldPassword').value;var n=document.getElementById('newPassword').value;var c=document.getElementById('confirmPassword').value;var a=document.getElementById('settingsAlert');if(!o||!n||!c){a.innerHTML='<div class="alert alert-warning">⚠️ Semua field harus diisi!</div>';return}if(n!==c){a.innerHTML='<div class="alert alert-warning">⚠️ Konfirmasi password tidak cocok!</div>';return}try{var r=await fetch('/admin/api/change-password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({old_password:o,new_password:n,confirm_password:c})});var d=await r.json();if(d.success){a.innerHTML='<div class="alert alert-success">✅ '+d.message+'</div>';document.getElementById('oldPassword').value='';document.getElementById('newPassword').value='';document.getElementById('confirmPassword').value=''}else{a.innerHTML='<div class="alert alert-danger">❌ '+d.message+'</div>'}}catch(e){a.innerHTML='<div class="alert alert-danger">❌ Server error!</div>'}}
async function updateTimeAndPrice(){var a=document.getElementById('settingsAlert');try{var r=await fetch('/admin/api/update-settings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({open_time:document.getElementById('openTime').value,close_time:document.getElementById('closeTime').value,harga_bayaran:document.getElementById('hargaBayaran').value})});var d=await r.json();a.innerHTML=d.success?'<div class="alert alert-success">✅ '+d.message+'</div>':'<div class="alert alert-danger">❌ '+d.message+'</div>'}catch(e){a.innerHTML='<div class="alert alert-danger">❌ Server error!</div>'}}
async function updateCatatan(){var a=document.getElementById('settingsAlert');try{var r=await fetch('/admin/api/update-settings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({catatan_bayaran:document.getElementById('catatanBayaran').value})});var d=await r.json();a.innerHTML=d.success?'<div class="alert alert-success">✅ Catatan berhasil disimpan!</div>':'<div class="alert alert-danger">❌ '+d.message+'</div>'}catch(e){a.innerHTML='<div class="alert alert-danger">❌ Server error!</div>'}}
</script>