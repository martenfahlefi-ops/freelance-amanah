<div class="top-bar"><div class="page-title">📋 Konfirmasi Setoran</div><div class="clock-display"><div><div class="date" id="clockDate"></div><div class="time" id="clockTime">00:00:<span class="seconds">00</span></div></div></div></div>
<div id="konfirmasiAlert"></div>
<div class="glass-card" style="padding:24px;"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;"><h4 style="color:var(--green-primary);">📨 Data Setoran Member</h4><button class="btn-sm btn-outline-light" onclick="refreshData()">🔄 Refresh</button></div><div class="table-container"><table class="table"><thead><tr><th>#</th><th>Nama Discord</th><th>Nomor WA</th><th>Nomor DANA</th><th>Username Email</th><th>Tanggal</th><th>Jam</th><th>Status</th><th>Aksi</th></tr></thead><tbody id="setoranBody"><% if (setoran && setoran.length > 0) { %><% setoran.forEach(function(s, i) { %><tr id="row<%= s.id %>"><td><%= i + 1 %></td><td><%= s.nama_discord %></td><td><%= s.nomor_wa %></td><td><%= s.nomor_dana %></td><td><%= s.username_email %></td><td><%= s.tanggal %></td><td><%= s.jam %></td><td><span id="badge<%= s.id %>" class="badge <% if (s.status === 'Pending') { %>badge-pending<% } else if (s.status === 'Accepted') { %>badge-accepted<% } else { %>badge-denied<% } %>"><%= s.status %></span></td><td><select id="statusSelect<%= s.id %>" class="form-control" style="width:auto;display:inline-block;padding:4px 8px;font-size:12px;" onchange="updateStatus(<%= s.id %>,this.value)"><option value="Pending" <%= s.status === 'Pending' ? 'selected' : '' %>>Pending</option><option value="Accepted" <%= s.status === 'Accepted' ? 'selected' : '' %>>Accepted</option><option value="Denied" <%= s.status === 'Denied' ? 'selected' : '' %>>Denied</option></select></td></tr><% }); %><% } else { %><tr><td colspan="9" class="msg-empty">Belum ada setoran dari member.</td></tr><% } %></tbody></table></div></div>
<script>
async function updateStatus(id,status){var a=document.getElementById('konfirmasiAlert');try{var r=await fetch('/admin/api/konfirmasi/'+id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:status})});var d=await r.json();if(d.success){a.innerHTML='<div class="alert alert-success">✅ Status diupdate ke: '+status+'</div>';setTimeout(function(){a.innerHTML=''},2000);var b=document.getElementById('badge'+id);b.textContent=status;b.className='badge ';if(status==='Pending')b.className+='badge-pending';else if(status==='Accepted')b.className+='badge-accepted';else b.className+='badge-denied'}else{a.innerHTML='<div class="alert alert-danger">❌ Gagal update!</div>'}}catch(e){}}
async function refreshData(){try{var r=await fetch('/admin/api/konfirmasi');var d=await r.json();var t=document.getElementById('setoranBody');if(d.length===0){t.innerHTML='<tr><td colspan="9" class="msg-empty">Belum ada setoran dari member.</td></tr>'}else{var h='';d.forEach(function(s,i){var bc='badge-pending';if(s.status==='Accepted')bc='badge-accepted';if(s.status==='Denied')bc='badge-denied';h+='<tr id="row'+s.id+'"><td>'+(i+1)+'</td><td>'+escapeHtml(s.nama_discord)+'</td><td>'+escapeHtml(s.nomor_wa)+'</td><td>'+escapeHtml(s.nomor_dana)+'</td><td>'+escapeHtml(s.username_email)+'</td><td>'+s.tanggal+'</td><td>'+s.jam+'</td><td><span id="badge'+s.id+'" class="badge '+bc+'">'+s.status+'</span></td><td><select id="statusSelect'+s.id+'" class="form-control" style="width:auto;display:inline-block;padding:4px 8px;font-size:12px;" onchange="updateStatus('+s.id+',this.value)"><option value="Pending"'+(s.status==='Pending'?' selected':'')+'>Pending</option><option value="Accepted"'+(s.status==='Accepted'?' selected':'')+'>Accepted</option><option value="Denied"'+(s.status==='Denied'?' selected':'')+'>Denied</option></select></td></tr>'});t.innerHTML=h}}catch(e){}}
setInterval(refreshData,15000);
function escapeHtml(t){var d=document.createElement('div');d.textContent=t||'';return d.innerHTML}
</script>