<!DOCTYPE html>
<html lang="id">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Member - FREELANCE AMANAH</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<div class="bg-animated"><div class="bg-gradient bg-gradient-1"></div><div class="bg-gradient bg-gradient-2"></div><div class="bg-gradient bg-gradient-3"></div></div>
<a href="https://discord.gg/VhmgYdgxV" target="_blank" class="floating-discord"><svg viewBox="0 0 24 24"><path d="M20.317 4.37a19.8 19.8 0 00-4.885-1.515c-.21.375-.444.864-.608 1.25a18.3 18.3 0 00-5.487 0c-.617-1.25-4.885-1.515-4.885-1.515C.533 9.046-.32 13.58.099 18.057l.031.057a19.9 19.9 0 005.993 3.03c.462-.63.874-1.295 1.226-1.994a13.1 13.1 0 01-1.872-.892l-.008-.128c.372-.292 4-1.793 12.062 0l.373.292-.006.127-1.873.892-.041.107 1.225 1.993.084.028a19.84 19.84 0 006.002-3.03l.032-.054c.5-5.177-.838-9.674-3.549-13.66zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419s.956-2.419 2.157-2.419 2.157 1.086 2.157 2.419-.956 2.419-2.157 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419s.955-2.419 2.157-2.419 2.157 1.086 2.157 2.419-.946 2.419-2.157 2.419z"/></svg></a>
<div class="member-container">
<div class="member-header"><h1>FREELANCE AMANAH</h1><div id="openStatus" class="member-status <%= isOpen ? 'open' : 'closed' %>"><span class="status-dot <%= isOpen ? 'open-dot' : 'closed-dot' %>" id="statusDot"></span><span id="statusText"><%= isOpen ? 'OPEN' : 'CLOSE' %></span></div><% if (!isOpen) { %><div style="color:#ff4444;font-size:14px;margin-top:8px;font-weight:600;">⚠️ Setoran sedang tutup hari ini. Buka kembali pukul <%= openTimeStr %> WIB.</div><% } %></div>
<div class="catatan-box" id="catatanBayaran"><%- (settings.catatan_bayaran || '').replace(/\n/g,'<br>') %></div>
<div class="form-section" id="setoranFormSection" style="<%= isOpen ? '' : 'display:none;' %>"><h3>📤 KIRIM SETORAN</h3><div id="formAlert"></div>
<div class="form-group"><label class="form-label">Nama Discord</label><input type="text" id="namaDiscord" class="form-control" placeholder="Masukkan nama Discord kamu"></div>
<div class="form-group"><label class="form-label">Nomor WhatsApp</label><input type="text" id="nomorWA" class="form-control" placeholder="Contoh: 628123456789"></div>
<div class="form-group"><label class="form-label">Nomor DANA</label><input type="text" id="nomorDANA" class="form-control" placeholder="Contoh: 628123456789"></div>
<div class="form-group"><label class="form-label">Username Email</label><select id="usernameEmail" class="form-control"><option value="">-- Pilih Email --</option><% emails.forEach(function(e){ %><option value="<%= e.email %>"><%= e.email %></option><% }); %></select></div>
<button class="btn-amanah btn-amanah-solid w-100" onclick="submitSetoran()" style="margin-top:12px;">📨 KIRIM SETORAN</button></div>
<div id="closedMessage" style="<%= isOpen ? 'display:none;' : '' %>" class="glass-card" style="text-align:center;padding:40px;"><div style="font-size:48px;margin-bottom:12px;">🔒</div><div style="font-size:18px;font-weight:600;color:#ff4444;">Setoran sedang tutup hari ini.</div><div style="color:#666;margin-top:8px;">Buka kembali pukul <strong id="openTimeDisplay"><%= openTimeStr %></strong> WIB.</div></div>
<div class="form-section" style="margin-top:24px;"><h3>🔍 CEK STATUS SETORAN</h3><div id="cekAlert"></div>
<div class="form-group"><label class="form-label">Nama Discord atau Nomor WA</label><input type="text" id="cekQuery" class="form-control" placeholder="Masukkan Nama Discord atau Nomor WA"></div>
<button class="btn-amanah w-100" onclick="cekStatus()" style="margin-top:12px;">🔍 CEK STATUS</button><div id="cekResult" style="margin-top:20px;"></div></div></div>
<script>
async function checkOpenStatus(){try{var r=await fetch('/member/api/open-status');var d=await r.json();var s=document.getElementById('openStatus');var t=document.getElementById('statusText');var dt=document.getElementById('statusDot');var f=document.getElementById('setoranFormSection');var c=document.getElementById('closedMessage');if(d.isOpen){s.className='member-status open';dt.className='status-dot open-dot';t.textContent='OPEN';if(f)f.style.display='';if(c)c.style.display='none'}else{s.className='member-status closed';dt.className='status-dot closed-dot';t.textContent='CLOSE';if(f)f.style.display='none';if(c)c.style.display='';document.getElementById('openTimeDisplay').textContent=d.openTime}}catch(e){}}
setInterval(checkOpenStatus,30000);
async function submitSetoran(){var n=document.getElementById('namaDiscord').value.trim();var w=document.getElementById('nomorWA').value.trim();var d=document.getElementById('nomorDANA').value.trim();var u=document.getElementById('usernameEmail').value;var a=document.getElementById('formAlert');if(!n||!w||!d||!u){a.innerHTML='<div class="alert alert-warning">⚠️ Semua field harus diisi!</div>';return}if(!/^[0-9]+$/.test(w)){a.innerHTML='<div class="alert alert-warning">⚠️ Nomor WA harus berupa angka!</div>';return}if(!/^[0-9]+$/.test(d)){a.innerHTML='<div class="alert alert-warning">⚠️ Nomor DANA harus berupa angka!</div>';return}try{var r=await fetch('/member/api/submit-setoran',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({nama_discord:n,nomor_wa:w,nomor_dana:d,username_email:u})});var j=await r.json();if(j.success){a.innerHTML='<div class="alert alert-success">✅ '+j.message+'</div>';document.getElementById('namaDiscord').value='';document.getElementById('nomorWA').value='';document.getElementById('nomorDANA').value='';document.getElementById('usernameEmail').value=''}else{a.innerHTML='<div class="alert alert-danger">❌ '+j.message+'</div>'}}catch(e){a.innerHTML='<div class="alert alert-danger">❌ Gagal terhubung ke server!</div>'}}
async function cekStatus(){var q=document.getElementById('cekQuery').value.trim();var a=document.getElementById('cekAlert');var r=document.getElementById('cekResult');if(!q){a.innerHTML='<div class="alert alert-warning">⚠️ Masukkan Nama Discord atau Nomor WA!</div>';r.innerHTML='';return}a.innerHTML='';try{var res=await fetch('/member/api/cek-status',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({query:q})});var d=await res.json();if(d.success&&d.data.length>0){var h='';d.data.forEach(function(i){var bc='badge-pending';if(i.status==='Accepted')bc='badge-accepted';if(i.status==='Denied')bc='badge-denied';h+='<div class="glass-card" style="padding:16px;margin-bottom:12px;"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;"><span style="font-weight:600;color:#fff;">'+escapeHtml(i.username_email)+'</span><span class="badge '+bc+'">'+i.status+'</span></div><div style="font-size:13px;color:#666;">Discord: '+escapeHtml(i.nama_discord)+' | '+i.tanggal+' '+i.jam+'</div></div>'});r.innerHTML=h}else{r.innerHTML='<div class="alert alert-info">🔍 '+d.message+'</div>'}}catch(e){r.innerHTML='<div class="alert alert-danger">❌ Gagal terhubung ke server!</div>'}}
function escapeHtml(t){var d=document.createElement('div');d.textContent=t;return d.innerHTML}
</script></body></html>